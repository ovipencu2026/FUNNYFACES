{
  "expo": {
    "name": "PulsFit",
    "slug": "pulsfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.ovipencu.pulsfit",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          }
        }
      ],
      [
        "react-native-health-connect"
      ]
    ]
  }
}
